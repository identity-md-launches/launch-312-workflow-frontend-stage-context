{
  "name": "kickoff-crowdfunding",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.18.0" },
  "overrides": { "playwright-core": "1.55.1" },
  "scripts": {
    "dev": "node scripts/export.mjs --prepare && vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && node scripts/export.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "playwright test --grep-invert @live",
    "test:live": "playwright test --grep @live --reporter=list",
    "verify:export": "node scripts/verify-export.mjs",
    "check:live": "node scripts/check-live.mjs"
  },
  "dependencies": {
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "viem": "2.37.9"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.55.1",
    "@types/node": "24.5.2",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.3",
    "typescript": "5.9.2",
    "vite": "7.1.7"
  }
}
